import java.util.Scanner;

class Tablica {
    int[] tab;

    Tablica(int n) {
        tab = new int[n];
    }

    void czytaj() {
        Scanner sc = new Scanner(System.in);

        for (int i = 0; i < tab.length; i++) {
            tab[i] = sc.nextInt();
        }
    }

    void wypisz() {
        for (int i = 0; i < tab.length; i++) {
            System.out.print(tab[i] + " ");
        }
    }
        void sortujBąbelkowo() {
            int n = tab.length;
            for (int i = 0; i < n - 1; i++) {
                for (int j = 0; j < n - i - 1; j++) {
                    if (tab[j] > tab[j + 1]) {
                        int a = tab[j];
                        tab[j] = tab[j + 1];
                        tab[j + 1] = a;
                    }
                }
            }
        }

    }


public class Main {
    public static void main(String[] args) {
        Tablica t = new Tablica(5);

        t.czytaj();
        t.sortujBąbelkowo();
        t.wypisz();

    }
}
