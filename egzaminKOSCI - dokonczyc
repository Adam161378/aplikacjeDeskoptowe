import java.util.Random;
public class kosc {
    public static int liczbaInstancji = 0;
    public String[] nazwyPlikow = {"kosc1.png", "kosc2.png", "kosc3.png",
                                     "kosc4.png", "kosc5.png", "kosc6.png"};
    public int liczbaOczek;
    public int indexPliku;
    public boolean czyDostepna;

    public kosc(int liczbaOczek){
        this.liczbaOczek = liczbaOczek;
        if(liczbaOczek > 0 && liczbaOczek < 7){
            this.liczbaOczek = liczbaOczek;
            this.indexPliku = liczbaOczek;
        }
         liczbaInstancji++;
        czyDostepna = true;

    }

    public kosc(){
        Random rand = new Random();
        int oczka = rand.nextInt(6)+1;
        indexPliku = oczka;
        liczbaOczek = oczka;
        czyDostepna = true;
        liczbaInstancji++;
    }
    public void nazwa(){
        if(czyDostepna == true){
            Random rand = new Random();
            int oczka = rand.nextInt(6)+1;
            liczbaOczek = oczka;
        }
    }

}
